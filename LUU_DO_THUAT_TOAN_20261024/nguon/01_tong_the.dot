digraph "01_tong_the" {

graph [rankdir=TB, bgcolor="transparent", pad="0.12", nodesep="0.34", ranksep="0.40", splines=polyline];
node [shape=box, fontname="DejaVu Sans", fontsize=17, margin="0.18,0.12", style="filled", fillcolor="#edf5ff", color="#365a7d", penwidth=1.4];
edge [fontname="DejaVu Sans", fontsize=14, color="#365a7d", fontcolor="#244461", arrowsize=0.8, penwidth=1.3];

start [shape=ellipse, fillcolor="#dff4e9", label="BẮT ĐẦU / CPU VÀO RUN"];
init [label="Khởi tạo: AUTO = 0; tạm dừng = 0\nBước = 0; xóa timer; bơm và van OFF"];
scan [shape=circle, width=0.52, fixedsize=true, label="A", fillcolor="white"];
read [shape=parallelogram, label="Đọc nút thật và HMI; lọc nút, bắt cạnh lệnh\nĐọc mức nước, quá tải, dừng khẩn và RTC"];
schedule [label="Xác định ca từ giờ PLC\n06:00 ≤ t < 08:00 hoặc 17:00 ≤ t < 20:30"];
commands [peripheries=2, label="Xử lý lỗi, RESET, AUTO và STOP\nThực hiện lưu đồ Hình 2"];
auto [shape=diamond, fillcolor="#fff2d8", label="Đã được cấp\nquyền AUTO?"];
off [label="Bước = 0; bơm và van OFF\nGọi TONR: IN = 0; R = 1", fillcolor="#f4f4f4"];
hours [shape=diamond, fillcolor="#fff2d8", label="Đang trong\ngiờ vận hành?"];
wait [label="Bước = 0; bơm và van OFF\nGọi TONR: IN = 0; R = 1\nGiữ AUTO và trạng thái tạm dừng", fillcolor="#f4f4f4"];
pause [shape=diamond, fillcolor="#fff2d8", label="Đang tạm dừng?"];
hold [label="Bơm và van OFF; giữ bước\nGọi đủ năm TONR\nGiữ timer bước hiện tại (IN = 0; R = 0)\nReset timer các bước khác", fillcolor="#fff2d8"];
sequence [peripheries=2, label="Chạy / cập nhật chu trình năm bước\nThực hiện lưu đồ Hình 3"];
update [shape=parallelogram, label="Cập nhật ngõ ra vật lý và HMI\nBơm, bốn van, đèn lỗi, bước và giây còn lại"];
next [shape=ellipse, fillcolor="#dff4e9", label="VÒNG QUÉT TIẾP THEO → A"];
start -> init -> scan -> read -> schedule -> commands -> auto;
auto -> hours [label="Có"]; auto -> off [label="Không"];
hours -> pause [label="Có"]; hours -> wait [label="Không"];
pause -> sequence [label="Không"]; pause -> hold [label="Có"];
off -> update; wait -> update; hold -> update; sequence -> update; update -> next;
{rank=same; auto; off}
{rank=same; hours; wait}
{rank=same; pause; hold}

}