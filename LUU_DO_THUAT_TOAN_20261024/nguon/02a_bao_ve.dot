digraph "02a_bao_ve" {

graph [rankdir=TB, bgcolor="transparent", pad="0.12", nodesep="0.34", ranksep="0.40", splines=polyline];
node [shape=box, fontname="DejaVu Sans", fontsize=17, margin="0.18,0.12", style="filled", fillcolor="#edf5ff", color="#365a7d", penwidth=1.4];
edge [fontname="DejaVu Sans", fontsize=14, color="#365a7d", fontcolor="#244461", arrowsize=0.8, penwidth=1.3];

start [shape=ellipse, fillcolor="#dff4e9", label="VÀO HÌNH 2A"];
safe [label="Tính AN TOÀN: đủ nước,\nkhông quá tải, không dừng khẩn"];
fault [label="Xác định LỖI HIỆN TẠI [1]"];
reset [shape=diamond, fillcolor="#fff2d8", label="RESET và AN TOÀN\nvà RTC hợp lệ?"];
clear [label="Xóa NHỚ LỖI", fillcolor="#dff4e9"];
bad [shape=diamond, fillcolor="#fff2d8", label="Có lỗi hiện tại?"];
latch [label="Đặt NHỚ LỖI = 1", fillcolor="#fde8e6"];
keep [label="Giữ NHỚ LỖI"];
alarm [label="Đèn báo lỗi = NHỚ LỖI"];
go [shape=ellipse, fillcolor="#dff4e9", label="SANG HÌNH 2B"];
start -> safe -> fault -> reset;
reset -> clear [label="Có"]; reset -> bad [label="Không"];
bad -> latch [label="Có"]; bad -> keep [label="Không"];
clear -> alarm; latch -> alarm; keep -> alarm; alarm -> go;

}