digraph "03_chu_trinh" {

graph [rankdir=TB, bgcolor="transparent", pad="0.12", nodesep="0.34", ranksep="0.40", splines=polyline];
node [shape=box, fontname="DejaVu Sans", fontsize=17, margin="0.18,0.12", style="filled", fillcolor="#edf5ff", color="#365a7d", penwidth=1.4];
edge [fontname="DejaVu Sans", fontsize=14, color="#365a7d", fontcolor="#244461", arrowsize=0.8, penwidth=1.3];

start [shape=ellipse, fillcolor="#dff4e9", label="VÀO CHU TRÌNH\nĐược chạy trong ca, không tạm dừng"];
copy [label="BƯỚC TIẾP THEO = BƯỚC HIỆN TẠI"];
zero [shape=diamond, fillcolor="#fff2d8", label="BƯỚC HIỆN TẠI = 0?"];
first [label="BƯỚC TIẾP THEO = 1\nGọi các TONR: IN = 0; R = 1"];
timer [label="Gọi đủ năm TONR\nBước hiện tại: IN = 1; R = 0\nBước khác: IN = 0; R = 1"];
done [shape=diamond, fillcolor="#fff2d8", label="Bước đã đủ 10 s?\n(TONR.Q = 1)"];
last [shape=diamond, fillcolor="#fff2d8", label="Đang ở bước 5?"];
one [label="BƯỚC TIẾP THEO = 1"];
inc [label="BƯỚC TIẾP THEO\n= BƯỚC HIỆN TẠI + 1"];
commit [label="Chốt BƯỚC HIỆN TẠI\n= BƯỚC TIẾP THEO"];
outputs [label="Giải mã bốn van theo bảng trạng thái\nBơm = OR trạng thái bốn van"];
back [shape=ellipse, fillcolor="#dff4e9", label="TRỞ VỀ HÌNH 1\nCập nhật ngõ ra / HMI, sang vòng quét mới"];
start -> copy -> zero;
zero -> first [label="Có"]; zero -> timer [label="Không"];
timer -> done; done -> last [label="Có"]; done -> commit [label="Chưa đủ"];
last -> one [label="Có"]; last -> inc [label="Không"];
first -> commit; one -> commit; inc -> commit;
commit -> outputs -> back;

}